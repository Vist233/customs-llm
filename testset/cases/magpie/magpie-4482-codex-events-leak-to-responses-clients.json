  },
  "severity": "medium",
  "detectable": "yes",
  "payload_origin": "reconstructed",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/responses",
    "body": {
      "model": "codex/gpt-6.1-terra",
      "stream": true,
      "input": "say OK"
    }
  },
  "assertions": [
    {
      "op": "absent_anywhere",
      "text": "codex.",
      "why": "events outside the Responses enum break strict clients"
    }
  ],
  "observed": "event: codex.rate_limits and codex.response.metadata arrive before response.created; intermittent, so it reads as a flaky upstream.",
  "upstream": {
    "status": 200,
    "sse": [
