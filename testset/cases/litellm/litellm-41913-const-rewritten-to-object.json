{
  "id": "litellm-41913-const-rewritten-to-object",
  "title": "JSON Schema const is rewritten to type: object for Gemini",
  "source": {
    "repo": "BerriAI/litellm",
    "issue": 41913,
    "url": "https://github.com/BerriAI/litellm/issues/41913",
    "state": "open"
  },
  "gateway": {
    "name": "litellm",
    "route": "gemini"
  },
  "category": "tool_schema_rewritten",
  "direction": "request",
  "protocol": {
    "in": "openai_chat",
    "out": "gemini_generate"
  },
  "severity": "high",
  "detectable": "yes",
  "payload_origin": "reconstructed",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "gem",
      "messages": [
        {
          "role": "user",
          "content": "pay"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "pay",
            "parameters": {
              "type": "object",
              "properties": {
                "currency": {
                  "const": "USD"
                }
              },
              "required": [
                "currency"
              ]
            }
          }
        }
      ]
    }
  },
  "assertions": [
    {
      "op": "contains_anywhere",
      "text": "USD",
      "why": "the pinned value must stay expressible in the forwarded schema"
    }
  ],
  "observed": "const is forwarded as {'type': 'object'}, so a pinned value becomes unconstrained.",
  "examples": {
    "bad": {
      "contents": [
        {
          "parts": [
            {
              "text": "pay"
            }
          ],
          "role": "user"
        }
      ],
      "tools": [
        {
          "function_declarations": [
            {
              "name": "pay",
              "parameters": {
                "properties": {
                  "currency": {
                    "type": "object"
                  }
                },
                "required": [
                  "currency"
                ],
                "type": "object"
              }
            }
          ]
        }
      ]
    }
  }
}
