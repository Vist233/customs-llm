  },
  "category": "error_masked",
  "direction": "error",
  "protocol": {
    "in": "openai_responses",
    "out": "openai_responses"
  },
  "severity": "high",
  "detectable": "yes",
  "payload_origin": "issue",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/responses",
    "body": {
      "model": "gpt-4.1",
      "input": "hi",
      "stream": true
    }
  },
  "assertions": [
    {
      "op": "contains_anywhere",
      "text": "invalid_prompt",
      "why": "the client must see the upstream error code, not a generic fallback"
    }
  ],
  "observed": "The error event in OpenAI's top-level shape becomes a generic failure; its code is gone, so retry and fallback logic cannot tell a flagged prompt from an outage.",
