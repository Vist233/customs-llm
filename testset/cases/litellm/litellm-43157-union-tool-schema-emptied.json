{
  "id": "litellm-43157-union-tool-schema-emptied",
  "title": "A union (anyOf / $ref) tool schema is emptied to properties: {} for Anthropic",
  "source": {
    "repo": "BerriAI/litellm",
    "issue": 43157,
    "url": "https://github.com/BerriAI/litellm/issues/43157",
    "state": "open"
  },
  "gateway": {
    "name": "litellm",
    "route": "anthropic"
  },
  "category": "tool_schema_rewritten",
  "direction": "request",
  "protocol": {
    "in": "openai_chat",
    "out": "anthropic_messages"
  },
  "severity": "high",
  "detectable": "yes",
  "payload_origin": "reconstructed",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "claude-sonnet-4-6",
      "messages": [
        {
          "role": "user",
          "content": "do it"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "do",
            "description": "union tool",
            "parameters": {
              "$defs": {
                "A": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "a"
                    },
                    "a": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "a"
                  ]
                },
                "B": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "b"
                    },
                    "b": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "kind",
                    "b"
                  ]
                }
              },
              "anyOf": [
                {
                  "$ref": "#/$defs/A"
                },
                {
                  "$ref": "#/$defs/B"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "assertions": [
    {
      "op": "contains_anywhere",
      "text": "\"kind\"",
      "why": "the union's fields must survive in some legal form"
    }
  ],
  "observed": "input_schema keeps $defs but drops anyOf and ships properties: {}; the model sees a tool with no parameters.",
  "notes": "Corner case: root-level anyOf with $ref, as generated by pydantic for Union types.",
  "examples": {
    "good": {
      "max_tokens": 4096,
      "messages": [
        {
          "content": [
            {
              "text": "do it",
              "type": "text"
            }
          ],
          "role": "user"
        }
      ],
      "model": "customs-anthropic",
      "tools": [
        {
          "description": "union tool",
          "input_schema": {
            "$defs": {
              "A": {
                "properties": {
                  "a": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "a"
                  }
                },
                "required": [
                  "kind",
                  "a"
                ],
                "type": "object"
              },
              "B": {
                "properties": {
                  "b": {
                    "type": "integer"
                  },
                  "kind": {
                    "const": "b"
                  }
                },
                "required": [
                  "kind",
                  "b"
                ],
                "type": "object"
              }
            },
            "properties": {},
            "type": "object"
          },
          "name": "do",
          "type": "custom"
        }
      ]
    }
  }
}
