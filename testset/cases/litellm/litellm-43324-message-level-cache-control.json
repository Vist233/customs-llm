{
  "id": "litellm-43324-message-level-cache-control",
  "title": "Message-level cache_control is dropped when content is a list",
  "source": {
    "repo": "BerriAI/litellm",
    "issue": 43324,
    "url": "https://github.com/BerriAI/litellm/issues/43324",
    "state": "open"
  },
  "gateway": {
    "name": "litellm",
    "route": "anthropic/ and bedrock converse"
  },
  "category": "cache_control_lost",
  "direction": "request",
  "protocol": {
    "in": "openai_chat",
    "out": "anthropic_messages"
  },
  "severity": "high",
  "detectable": "yes",
  "payload_origin": "reconstructed",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "m",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "cache_control": {
            "type": "ephemeral"
          },
          "content": [
            {
              "type": "text",
              "text": "LONG-PREFIX LONG-PREFIX LONG-PREFIX LONG-PREFIX "
            }
          ]
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    }
  },
  "assertions": [
    {
      "op": "contains_anywhere",
      "text": "cache_control",
      "why": "a breakpoint must reach Anthropic somewhere"
    }
  ],
  "observed": "Breakpoint set on a message whose content is a list never reaches the provider; no error. Repeat requests are billed at the full input rate.",
  "examples": {
    "bad": {
      "max_tokens": 16,
      "messages": [
        {
          "content": [
            {
              "text": "LONG-PREFIX LONG-PREFIX LONG-PREFIX LONG-PREFIX ",
              "type": "text"
            },
            {
              "text": "hi",
              "type": "text"
            }
          ],
          "role": "user"
        }
      ],
      "model": "customs-anthropic"
    }
  }
}
