{
  "id": "new-api-8048-injected-placeholder-text",
  "title": "Chat to Claude conversion injects a \"...\" text block into tool_use-only assistant turns",
  "source": {
    "repo": "QuantumNous/new-api",
    "issue": 8048,
    "url": "https://github.com/QuantumNous/new-api/issues/8048",
    "state": "closed"
  },
  "gateway": {
    "name": "new-api",
    "route": "claude"
  },
  "category": "field_injected",
  "direction": "request",
  "protocol": {
    "in": "openai_chat",
    "out": "anthropic_messages"
  },
  "severity": "medium",
  "detectable": "yes",
  "payload_origin": "reconstructed",
  "verified": true,
  "inbound": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "m",
      "max_tokens": 64,
      "messages": [
        {
          "role": "user",
          "content": "list files"
        },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "ls",
                "arguments": "{}"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_1",
          "content": "a.txt"
        }
      ]
    }
  },
  "assertions": [
    {
      "op": "absent_anywhere",
      "text": "\"text\":\"...\"",
      "why": "a placeholder text block must not be invented"
    }
  ],
  "observed": "An assistant turn with only tool_calls gets a fabricated text block \"...\" because the emptiness check ignores tool_calls.",
  "examples": {
    "good": {
      "max_tokens": 64,
      "messages": [
        {
          "content": [
            {
              "text": "list files",
              "type": "text"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "[System: Empty message content sanitised to satisfy protocol]",
              "type": "text"
            },
            {
              "id": "call_1",
              "input": {},
              "name": "ls",
              "type": "tool_use"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "content": "a.txt",
              "tool_use_id": "call_1",
              "type": "tool_result"
            }
          ],
          "role": "user"
        }
      ],
      "model": "customs-anthropic",
      "tools": [
        {
          "description": "This is a dummy tool call",
          "input_schema": {
            "properties": {},
            "type": "object"
          },
          "name": "dummy_tool",
          "type": "custom"
        }
      ]
    }
  }
}
